<%- include('../partials/header') %>

<main>
    <section class="faculty-detail">
        <h1><%= faculty.name %></h1>

        <div class="faculty-information">
            <p>
                <strong>Title:</strong>
                <%= faculty.title %>
            </p>

            <p>
                <strong>Department:</strong>
                <%= faculty.department %>
            </p>

            <p>
                <strong>Office:</strong>
                <%= faculty.office %>
            </p>

            <p>
                <strong>Phone:</strong>
                <a href="tel:<%= faculty.phone %>">
                    <%= faculty.phone %>
                </a>
            </p>

            <p>
                <strong>Email:</strong>
                <a href="mailto:<%= faculty.email %>">
                    <%= faculty.email %>
                </a>
            </p>
        </div>

        <p>
            <a href="/faculty">Back to Faculty Directory</a>
        </p>
    </section>
</main>

<%- include('../partials/footer') %>