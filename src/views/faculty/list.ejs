<%- include('../partials/header') %>

<main>
    <section class="faculty-page">
        <h1>Faculty Directory</h1>

        <p>
            Browse faculty members by name, department, or title.
        </p>

        <div class="faculty-sort">
            <h2>Sort Faculty</h2>

            <a href="/faculty?sort=name">Name</a>
            <a href="/faculty?sort=department">Department</a>
            <a href="/faculty?sort=title">Title</a>
        </div>

        <section class="faculty-grid">
            <% faculty.forEach(member => { %>
                <article class="faculty-card">
                    <h2>
                        <a href="/faculty/<%= member.id %>">
                            <%= member.name %>
                        </a>
                    </h2>

                    <p>
                        <strong>Department:</strong>
                        <%= member.department %>
                    </p>

                    <p>
                        <strong>Title:</strong>
                        <%= member.title %>
                    </p>

                    <a href="/faculty/<%= member.id %>">
                        View Profile
                    </a>
                </article>
            <% }); %>
        </section>
    </section>
</main>

<%- include('../partials/footer') %>